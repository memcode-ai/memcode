# memcode self-host configuration. Copy to deploy/docker/.env and fill in.

# REQUIRED: the one shared bearer the CLI authenticates with. Any strong
# random string (e.g. `openssl rand -hex 32`).
MEMCODE_SELFHOST_TOKEN=

# Backend selection: anthropic | fireworks | hybrid. Start with a single
# vendor (anthropic is simplest). `hybrid` serves every keyed vendor plus a
# cheap coding lane, but requires MEMCODE_FIREWORKS_URL/_KEY/_MODEL for that
# lane.
MEMCODE_PROVIDER=anthropic

# Provider keys — set at least one. These are YOUR keys; the gateway serves
# on them and bills nothing.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# The cheap coding lane (optional): any OpenAI-compatible endpoint.
MEMCODE_FIREWORKS_URL=
MEMCODE_FIREWORKS_KEY=
MEMCODE_FIREWORKS_MODEL=

# Optional knobs
# PORT=8080
# MEMCODE_ORG_RPM=600
# ANTHROPIC_ADVISOR_MODEL=
